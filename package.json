{
  "name": "churchtools-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the ChurchTools API",
  "license": "MIT",
  "author": "Noah Reinbold",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "churchtools",
    "claude"
  ],
  "homepage": "https://github.com/NoahDR/churchtools-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoahDR/churchtools-mcp.git"
  },
  "bugs": "https://github.com/NoahDR/churchtools-mcp/issues",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test:live": "node --env-file=.env.live node_modules/vitest/vitest.mjs run --project live"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
